# Optional Neon/Postgres connection. When set, the complete StoreData object is
# persisted in Postgres; when unset, the local data/store.json fallback is used.
DATABASE_URL=
# Optional: real STANDLEO LITE game-server base URL.
# Leave unset to keep the adapter in mock mode.
STANDLEO_LITE_API_URL=
# Secret used by a local game-to-site result bridge.
MATCH_IMPORT_TOKEN=
# Keep false outside local development; when true, recovery returns a token for testing.
RESET_TOKEN_DEBUG=false
